{
  "post_file_edit": [
    {
      "name": "Clasp Status Check",
      "command": "powershell -ExecutionPolicy Bypass -Command \"clasp status\"",
      "matcher": "*",
      "return_output_to_agent": true,
      "continue_on_failure": false
    }
  ],
  "post_task": [
    {
      "name": "Clasp Push Validation",
      "command": "powershell -ExecutionPolicy Bypass -Command \"clasp push\"",
      "return_output_to_agent": true,
      "continue_on_failure": false
    }
  ]
}
