# TASK-004: DEV E2E 테스트 환경변수 템플릿
#
# 사용법: 이 파일을 .env 로 복사한 뒤 실제 값을 채운다.
#   cp .env.example .env
#
# ⚠️ .env 는 .gitignore에 등록되어 있다. 절대 커밋하지 말 것.
# ⚠️ Production Web App URL을 여기에 넣지 말 것 (playwright.config.js가 실행을 차단한다).

# DEV Web App URL (.../exec). DEV Apps Script의 배포 URL만 사용한다.
PLAYWRIGHT_BASE_URL=

# DEV 스프레드시트의 👤 사용자관리 시트에 등록된 테스트 계정
DEV_TEST_USERNAME=
DEV_TEST_PASSWORD=

# (선택) Google 로그인이 필요한 배포에서 인증된 세션을 재사용할 경우의 storageState 경로.
# 해당 파일에는 세션 토큰이 들어가므로 반드시 저장소 밖에 두거나 .gitignore 처리할 것.
# PLAYWRIGHT_STORAGE_STATE=
